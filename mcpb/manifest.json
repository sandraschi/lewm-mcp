{
  "manifest_version": "0.2",
  "name": "lewm-mcp",
  "version": "0.2.1",
  "description": "FastMCP 3.2 server for LeWorldModel (LeWM): JEPA train/infer, planning hooks, agentic prep, fleet webapp",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "lewm_world", "description": "lewm_world" },
    { "name": "lewm_status", "description": "lewm_status" },
    { "name": "lewm_agentic_workflow", "description": "lewm_agentic_workflow" },
    { "name": "show_lewm_status_card", "description": "show_lewm_status_card" }
  ]
}
